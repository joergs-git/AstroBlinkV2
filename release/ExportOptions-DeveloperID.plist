<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Notarised build distributed via GitHub Releases. Includes the MCP proxy. -->
    <key>method</key>
    <string>developer-id</string>
    <key>teamID</key>
    <string>FDSVBU33S8</string>
    <!-- signingCertificate pins the identity type: without it xcodebuild picks the wrong
         one and the export fails. signingStyle MUST be automatic: the Developer ID profile
         ("Mac Team Direct Provisioning Profile") is Xcode-managed, and with manual Xcode 27
         refuses it ("is Xcode managed, but signing settings require a manually managed
         profile") or, without a mapping, claims no profile has the iCloud + Push features
         (verified 2026-10-22, 6.9.2). Needs -allowProvisioningUpdates on the export. -->
    <key>signingStyle</key>
    <string>automatic</string>
    <key>signingCertificate</key>
    <string>Developer ID Application</string>
    <key>destination</key>
    <string>export</string>
</dict>
</plist>
