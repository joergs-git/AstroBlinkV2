<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- App Store build. Archived separately with SKIP_MCP_PROXY=1: the App Store requires
         app-sandbox=true on every embedded executable, and the MCP proxy is unsandboxed. -->
    <key>method</key>
    <string>app-store-connect</string>
    <key>teamID</key>
    <string>FDSVBU33S8</string>
    <!-- signingStyle MUST be automatic: the Store profile ("Mac Team Store Provisioning
         Profile") is Xcode-managed; with manual, Xcode 27 claims no profile has the iCloud +
         Push features. Automatic needs a signed-in Apple ID in Xcode (Settings → Accounts) and
         -allowProvisioningUpdates on the export (verified 2026-10-23, 6.9.2 build 116). -->
    <key>signingStyle</key>
    <string>automatic</string>
    <key>signingCertificate</key>
    <string>Apple Distribution</string>
    <key>destination</key>
    <string>upload</string>
    <key>manageAppVersionAndBuildNumber</key>
    <false/>
</dict>
</plist>
